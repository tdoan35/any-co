{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anyco/game-state/1",
  "title": "Game state dump",
  "type": "object",
  "required": ["schema_version", "scene", "tick", "run", "player", "resources", "entities", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "crashed": { "type": "boolean" },
    "scene": { "type": "string", "minLength": 1, "maxLength": 40 },
    "tick": { "type": "integer", "minimum": 0 },
    "run": {
      "type": "object",
      "required": ["started", "over", "seed", "elapsed_ticks"],
      "additionalProperties": false,
      "properties": {
        "started": { "type": "boolean" },
        "over": { "type": "boolean" },
        "seed": { "type": "integer" },
        "elapsed_ticks": { "type": "integer", "minimum": 0 }
      }
    },
    "player": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": { "type": ["number", "integer", "string", "boolean"] }
    },
    "resources": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "x", "y", "w", "h"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1, "maxLength": 40 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "w": { "type": "number", "minimum": 0 },
          "h": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": { "type": ["number", "integer", "string", "boolean"] }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tick", "message"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ui": {
      "type": "array",
      "description": "Every visible UI element of the CURRENT phase's screen. Optional: games without it still validate, but ui-lint is a release-gate layer only when present.",
      "items": {
        "type": "object",
        "required": ["id", "rect", "z", "visible"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, w, h] in viewport pixels, origin top-left of the window (the --resolution backbuffer), not the play-field.",
            "items": { "type": "number", "minimum": 0 }
          },
          "z": { "type": "number", "description": "draw order; higher renders on top" },
          "visible": { "type": "boolean" },
          "overlay": { "type": "boolean", "description": "tooltips/modals: exempt from the overlap check" },
          "text_px": { "type": "number", "minimum": 0, "description": "font size in px when the element renders text" },
          "parent": { "type": "string", "description": "id of the container this element is inside; parent/child overlaps are allowed" },
          "contains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "ids of children nested in this element; overlaps with them are allowed"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
