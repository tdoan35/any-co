{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anyco/asset-manifest/1",
  "title": "Asset manifest",
  "type": "object",
  "required": ["schema_version", "style_bible", "grid", "palette", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "style_bible": { "type": "string", "minLength": 1 },
    "grid": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "outline": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "palette", "anchor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 60 },
          "type": { "enum": ["sprite", "tileset", "ui", "audio", "font", "other"] },
          "path": { "type": "string", "pattern": "^assets/", "maxLength": 200 },
          "size": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          },
          "frames": { "type": "integer", "minimum": 1, "maximum": 64 },
          "palette": {
            "type": "array",
            "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          },
          "anchor": { "type": ["string", "null"], "maxLength": 60 },
          "anchor_mode": { "enum": ["same-subject", "style"] },
          "outline": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
          "anim": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["frame-strip", "cutout", "procedural"] },
              "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
              "parts": { "type": "array", "items": { "type": "string", "maxLength": 40 } }
            },
            "additionalProperties": false
          },
          "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
