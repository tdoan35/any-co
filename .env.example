# Naïve
NAIVE_API_KEY=
NAIVE_BASE_URL=https://api.vetta.sh

# Fast inference provider(s) for the local runner
INFERENCE_API_KEY=
INFERENCE_BASE_URL=

# Embeddings (Greenlight gap map: text-embedding-3-small); also the ui-ux-designer's vision model
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL for the ui-ux-designer (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Art APIs
PIXELLAB_API_KEY=
RETRO_DIFFUSION_API_KEY=
# Local lab ComfyUI for provider comfy (never the production port 8188)
COMFY_BASE_URL=
# PixelLab reserve in generations (shared balance across studios): art_generate refuses pixellab at/below it
PIXELLAB_MIN_REMAINING=
# Per-studio default when an art_generate call names no provider: comfy | pixellab | retrodiffusion (unset = the anchor's bake-off winner)
ART_DEFAULT_PROVIDER=

# Distribution
BUTLER_API_KEY=
STEAM_BUILD_ACCOUNT=

# Social uploads (social-media-manager). Real YouTube sends need all three plus STUDIO_DISCLOSURE
# matching a phrase in the description. TikTok live posts are refused by the tool.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
STUDIO_DISCLOSURE=

# Spend caps (USD) for local inference
LOCAL_SPEND_CAP_USD=

# Neon AI gateway (OpenAI-compatible); Eng agents run on it (local runner only)
NEON_AI_API_KEY=
NEON_AI_BASE_URL=
NAIVE_EMAIL_IDENTITY_ID=
NAIVE_EMAIL_INBOX_ID=
STUDIO_SITE_APP_ID=
# Art generation deadline per call (ms); default 180000
ART_GENERATE_TIMEOUT_MS=
# Studio window: show another folder's runs (a mirror); outside this repo's runs/ it is read-only
STUDIO_RUNS_DIR=
STUDIO_WINDOW_READONLY=
